    {
      "kind": "addition",
      "subject": "हलथिन",
      "rationale": "इब्रानी में क्रिया नञ हइ — गिनती के सूची बिना क्रिया के ठाढ़ हकइ।"
    },
    {
      "kind": "idiom",
      "subject": "ליום",
      "rationale": "अरथ हकइ 'हर दिन के हिसाब से', रोज — पहरे के बरखास्त-बदली के गिनती।"
    },
    {
      "kind": "crux",
      "subject": "אספים",
      "rationale": "आसुप्पिम: कुछ अनुवाद 'खजान-घर' कहऽ हइ, कुछ 'जमा करे के जगह' — जगह के नाम जस के तस रखलइ।"
    },
    {
      "kind": "measurement",
      "subject": "गिनती",
      "rationale": "दुआर-रखवार के बाँट के गिनती — दिशा-दने हर टोली के गिनती।"
    }
  ],
  "translation": "पूरब दने लवियन छह ⟨हलथिन⟩, उत्तर दने रोज चार, दक्खिन दने रोज चार, आउ आसुप्पिम दने दू-दू।",
