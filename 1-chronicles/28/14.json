    {
      "kind": "crux",
      "subject": "עבודה ועבודה",
      "rationale": "किताब के सब अनुवाद 'हर तरह के सेवा' कहऽ हथिन; इब्रानी दू बेर एके सब्द दोहरावऽ हे — ओकरा ओइसने रखलन।"
    }
