    {
      "kind": "addition",
      "subject": "रहतइ",
      "rationale": "इब्रानी पाँती में किरिया नञ हइ — वाचा पूरा करे बर जोड़ल किरिया, कोस्ठक में"
    },
    {
      "kind": "wordplay",
      "subject": "לכל",
      "rationale": "चार बेर 'हर\/सब' के दोहराव — ढाँचा के चाल, मगही में साँस बचलइ हइ"
    },
    {
      "kind": "you",
      "subject": "शलोमो के बतावल",
      "rationale": "दाविद अपन बेटा शलोमो के सीधे बतावऽ हथिन — 'तोहर संग', 'तोहर बात'"
    },
    {
      "kind": "crux",
      "subject": "מחלקות",
      "rationale": "'बिभाग' बनाम 'बिभाजन' — पुरोहित आउ लेवी के ड्यूटी-पाली के बाँट, सादा सूची नञ"
    }
  ],
  "translation": "आउ देखऽ, पुरोहित सब आउ लेवी सब के बिभाग एलोहीम के घर के सब सेवा-काज बर हइ, आउ तोहर संग सब काम में हर दान-दिल बुद्धिमान आदमी हइ, हर सेवा-काज बर; आउ सरदार सब आउ सब लोग हर तोहर बात बर ⟨रहतइ⟩।",
