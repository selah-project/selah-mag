    {
      "kind": "addition",
      "subject": "हतिस",
      "rationale": "हिब्रू के बाक्य में क्रिया नञ हइ — 'तूँ यिस्राएल में एलोहीम' — मगही के 'हतिस' जोड़ल गेल"
    },
    {
      "kind": "crux",
      "subject": "मिन्हा",
      "rationale": "'शाम के मिन्हा' कइस्न बलि हलइ — अनाज के भेंट या शाम के बलि; एहाँ लिप्यन्तरन रखल गेल"
    },
    {
      "kind": "you",
      "subject": "यहवे के अगुवाई में",
      "rationale": "एलियाहु सीधे यहवे के संग बोलऽ हइ"
    },
    {
      "kind": "invitation",
      "subject": "जानल जाव",
      "rationale": "एलियाहु के प्रार्थना लोग के जाने बर आग्रह करऽ हइ कि यहवे ही एलोहीम हथिन"
    }
  ],
  "translation": "आउ जब मिन्हा चढ़ावे के समय अइलइ, तब नबी एलियाहु नजदीक अइलन आउ कहलनका — यहवे, अवराहाम, यित्सहाक आउ यिस्राएल के एलोहीम, आज ई जानल जाव कि तूँ यिस्राएल में एलोहीम हतिस, आउ हम तोहर नौकर ही, आउ तोहरे बचन से हम ⟨את⟩ ई सब बात कइली।",
