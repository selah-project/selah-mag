    {
      "kind": "crux",
      "subject": "ויארכו",
      "rationale": "'ओकनी लम्बा कइलन' (डण्डा खींचलन) बनाम 'डण्डा लम्बा भेलन' (एतना लम्बा रहन) — क्रिया के करता पुरोहित या डण्डा स्वयं, दूनो पढ़ाहइं।"
    },
    {
      "kind": "measurement",
      "subject": "ढेर के लम्बाई",
      "rationale": "डण्डा सब के लम्बाई आउ देखाय के जगह के सुनिश्चित माप — जगह के विवरण।"
    }
  ],
  "translation": "आउ डण्डा सब एतना लम्बा भेलन कि डण्डा सब के सिरा पवित्तर जगह से दबीर के सामने देखायलन, बाहिर नञ देखायल; आउ ओकनी ओहाँ ई दिन तक रहलन।",
