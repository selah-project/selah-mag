    {
      "kind": "substitution",
      "subject": "मुँह",
      "rationale": "יהוה के पי सचमुच „मुँह“ हकइ; चलनसार अनुवाद एकरा आज्ञा\/बचन कर दे हथिन — हमनी मुँह रखलिये।"
    },
    {
      "kind": "addition",
      "subject": "तब",
      "rationale": "इब्रानी वहित वाक्य अपूर्ण छोड़ऽ हइ („अच्छा होतइ“ कहले बिना); शर्त के पूरा होवे के जोड़ मगही के बनावट माँगऽ हइ।"
    }
  ],
  "translation": "जँ तोहनी यहवे के डरब, ⟨אתו⟩ ओकर सेवा करब, ओकर बोली सुनब, आउ यहवे के ⟨את⟩ मुँह के बिरुद्ध नञ बगावब, तब तोहनी भी आउ ऊ राजा भी जे तोहनी पर राज करऽ हइ, यहवे तोहनी के एलोहीम के पाछा चलब।",
