    {
      "kind": "addition",
      "subject": "यिशै",
      "rationale": "करता इब्रानी पाठ में छिपल हइ (विधिवत करता-रहित क्रिया); बाक्य समझे बर जोड़ल गेलइ।"
    },
    {
      "kind": "addition",
      "subject": "हलइ",
      "rationale": "रूप-वर्णन के क्रिया-हीन ढेर में मगही के क्रिया चाही।"
    },
    {
      "kind": "crux",
      "subject": "אדמוני",
      "rationale": "एकरा मतलब लाल-रंग के बाल या गोरा रंग — दाविद के रूप के प्रसिद्ध मतभेद; 'लालिमा लिखल गोरा' जस के तस रखल गेलइ।"
    },
    {
      "kind": "you",
      "subject": "शमुएल",
      "rationale": "यहवे के आज्ञा सीधे शमुएल के — उठऽ, ओकर अभिसेक करऽ।"
    },
    {
      "kind": "wordplay",
      "subject": "זה הוא",
      "rationale": "'ईहे ऊ हइ' — 7 पद के चुनाव-फैसला के तीखा अन्त, एकरे छोट घोसना में पूरा खेप पूरा होवऽ हइ।"
    }
  ],
  "translation": "आउ ⟨यिशै⟩ भेजलक आउ ओकरा ले अनलक, आउ ऊ ⟨हलइ⟩ अदमोनी — लालिमा लिखल गोरा — सुन्दर आँख के संग, देखे में भला। आउ यहवे कहलन: उठऽ, ओकर अभिसेक करऽ, काहे कि ईहे ऊ हइ।",
