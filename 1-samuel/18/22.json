      "rationale": "बात छुप के करे के हुकुम — शाउल के चाल छुपावल जा रहलइ हे।"
    },
    {
      "kind": "you",
      "subject": "दाविद",
      "rationale": "नौकर के मुँह से दाविद से सीधा सम्बोधन।"
    },
