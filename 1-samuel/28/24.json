    {
      "kind": "substitution",
      "subject": "मत्ज्जा",
      "rationale": "बिना खमीर के रोटी — खमीर-रहित अरथ मगही में अलग सब्द नञ होवे से रूप लिप्यन्तरित रहल।"
    }
