    {
      "kind": "addition",
      "subject": "⟨कृपा कर के⟩",
      "rationale": "'नא' विनम्रता के छोट कण हकइ; मगही में अलग उपाधि के जरूरत पड़ल।"
    },
    {
      "kind": "you",
      "subject": "जनाना के ओर",
      "rationale": "शाउल ओअब वाली जनाना से सीधे सम्बोधन में बोलऽ हइ।"
    },
    {
      "kind": "secret",
      "subject": "छपावल रूप, रात के जाए",
      "rationale": "छपा कपड़ा, दू आदमी, रात — छुपल ज्ञान के खोज के हथियार बन्नऽ हइ।"
    },
    {
      "kind": "crux",
      "subject": "והעלי…את",
      "rationale": "'ऊपर लावऽ' — मरल के परान के ओहने से उठावल; जादू के मानल जाऽ हइ कि ओ ओअब के जरे नञ, ओहने से चढ़ऽ हइ।"
    }
  ],
  "translation": "आउ शाउल अपना के छपा लेलन आउ दोसर कपड़ा पहिरलन, आउ ऊ गेलन — ऊ आउ दू आदमी ओकर संग — आउ ओ सब रात में ओ जनाना लग अइलन; आउ ओ कहलन: ओअब के जरे हमरा बर भबिस बतावऽ, आउ ⟨את⟩ जेकरा हम तोहरा बताबइ ओकरा हमरा लग ऊपर लावऽ।",
