    {
      "kind": "addition",
      "subject": "हक",
      "rationale": "'ई यिस्राएल पर' पूरा बाक्य बनावे बर संज्ञा चाही; हिब्रू में खाली 'ई यिस्राएल पर' कहल गेल हकइ"
    },
