      "kind": "idiom",
      "subject": "अकास के अकास",
      "rationale": "समी-हशमीम — सबसे ऊपरी अकास; शाब्दिक दोहराव रखल गेल।"
    },
    {
      "kind": "you",
      "subject": "हूराम (सूर के राजा) के",
      "rationale": "पूरा पत्र ओकरा संग बोलल जा रहलइ हे — ई पद ओहे पत्र के हिस्सा हकइ।"
    }
