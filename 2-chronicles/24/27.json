    {
      "kind": "crux",
      "subject": "המשא",
      "rationale": "बोझ — अरथ में 'भविस-बाणी' या 'दबाव' दोनो सम्भव हइ; आक्षरिक 'बोझ' रखल गेलन।"
    },
    {
      "kind": "addition",
      "subject": "के बारे में",
      "rationale": "इब्रानी सूची-बनावट के बदला मगही में सम्बन्ध-सब्द जोड़ल गेलन।"
    },
    {
      "kind": "elision",
      "subject": "עמציהו के राज्य-सूचना",
      "rationale": "पद सामान्य राजा-समाप्ति सूत्र में बाँधल गेलन — संरचनात्मक तथ्य।"
    }
  ],
  "translation": "आउ ओकर बेटा के बारे में, आउ ओकरा ऊपर पड़ल बोझ के बहुतायत, आउ एलोहीम के घर के नींव — देखऽ, ई सब राजा सब के पुस्तक के मिद्रास में लिखल हकइ; आउ ओकर बेटा अमत्स्याहू ओकर जगह राजा भेलन।",
