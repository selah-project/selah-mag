    {
      "kind": "measurement",
      "subject": "आयु आउ राज-बरिस",
      "rationale": "राजा के उमिर आउ राज के बरिस गिनल गेलनइ — बिस बरिस, सोह्रह बरिस।"
    },
    {
      "kind": "idiom",
      "subject": "बעיני יהוה",
      "rationale": "इब्रानी बोलचाल 'यहवे के आँख में' — मगही में ओही चाल रखल गेलइ।"
    },
    {
      "kind": "addition",
      "subject": "⟨खुद⟩",
      "rationale": "हिब्रू के तुलना-बाक्य में करता बतावै बर सर्बनाम जोड़ल गेलइ।"
    }
  ],
  "translation": "बीस बरिस के आहाज ओकर राज करते बइठलन, आउ सोह्रह बरिस ऊ यरूशलयिम में राज कइलन; बाकि यहवे के आँख में जे ठीक हकइ ऊ ⟨खुद⟩ ओकर बाप दाविद जइसन नञ कइलन।",
