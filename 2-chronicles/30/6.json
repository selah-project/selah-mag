    {
      "kind": "you",
      "subject": "हे यिस्राएल के बेटा सब",
      "rationale": "चिट्ठी सीधे उत्तर राज्य के परजा के संबोधन हकइ।"
    },
    {
      "kind": "invitation",
      "subject": "लौट जावऽ",
      "rationale": "शूब (שוב) के हुकुम — वापसी के बोलावनी।"
    },
    {
      "kind": "wordplay",
      "subject": "שובו \/ וישב",
      "rationale": "एके जड़ के दू बेर — 'तोहनी लौटऽ, ऊ लौटतन' — शब्दक्रीड़ा साफ हे।"
    },
    {
      "kind": "crux",
      "subject": "וישב",
      "rationale": "'ऊ लौटतन' (वापसी करतन) बनाम 'ताकि ऊ लौटतन' — मकसद बनाम नतीजा के पढ़ावा।"
    }
  ],
  "translation": "आउ दौड़इया लोग राजा आउ ओकर सरदारन के हाथ के चिट्ठी ले के, राजा के हुकुम के मोताबिक, पूरा यिस्राएल आउ यहूदा में गेलन हलन, कहऽ कि — हे यिस्राएल के बेटा सब, अवराहाम (अब्राहम), यित्सहाक (इसहाक) आउ यिस्राएल (इस्राएल) के एलोहीम यहवे के ओर लौट जावऽ, ताकि ऊ अस्सूर के राजा सब के हाथ से तोहनी में से बचल बाकी लोग के ओर लौटतन।",
