    {
      "kind": "idiom",
      "subject": "עד...עד",
      "rationale": "दू बर 'जब तक' के दोहराव इब्रानी के चाल हकइ — ओकरा जस के तस रखल गेलन।"
    },
    {
      "kind": "wordplay",
      "subject": "מלעבים\/מתעतעים",
      "rationale": "तीन किरिया (मजाक उड़ौना, तुच्छ जानना, धोखा देना) के इब्रानी परूप मिलत-जुलत हकइ; मगही में ओ लय नञ आवऽ हइ।"
    },
    {
      "kind": "substitution",
      "subject": "इलाज",
      "rationale": "מרפא के साफ अरथ 'बिनती\/भेजन' हकइ — 'कोनो इलाज नञ बचलन' कथा के मोताबिक सुभाविक रूप हकइ।"
    }
  ],
  "translation": "बाकि ओ एलोहीम के दूत के मजाक उड़ौलक, ओकर बचन के तुच्छ जानलक, आउ ओकर नबी के संग धोखा कइलक — जब तक यहवे के कोप ओकर लोग बर चढ़लन, जब तक कोनो इलाज नञ बचलन।",
