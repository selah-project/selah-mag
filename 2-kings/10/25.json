    {
      "kind": "crux",
      "subject": "לשלשים",
      "rationale": "'तीसरे दरजा के सैनिक\/सरदार' बनाम 'तीन-तार वाला बाजा बजइए वाला' — ई सब्द दुनू अरथ में आवऽ हइ।"
    },
    {
      "kind": "idiom",
      "subject": "לפי חרב",
      "rationale": "इब्रानी के साक्षात रूप 'तलवार के मुँह से' — मुँह = धार के किनार; मगही में साक्षात रखल गेल।"
    },
    {
      "kind": "crux",
      "subject": "עיר בית הבעל",
      "rationale": "'बाल के घर के नगर तक' बनाम BSB 'बाल के मन्दिर के भीतरी कोठरी' (עיר के अरथ 'हाथी-कोठरी' भी)।"
    },
    {
      "kind": "you",
      "subject": "दौड़ैत लोग आउ सिपाही-सरदार लोग के",
      "rationale": "येहू के हुक्म सीधा ओकरा सैनिक लोग के — आदेश के सीधा सम्बोधन।"
    }
  ],
  "translation": "आउ जखन ओकरा चढ़ावे बर बलि पूरा करए से तब येहू दौड़ैत लोग आउ सिपाही-सरदार लोग के कहलन — भीतर जाऽ, मार डारऽ, कोनो आदमी बाहर नञ निकलऽ। आउ ऊ लोग तलवार के मुँह से ओकनी के मार डारलन, आउ दौड़ैत लोग आउ सिपाही-सरदार लोग ओकनी के ⟨बाहर⟩ फेंकलन, आउ बाल के घर के नगर तक गेलन।",
