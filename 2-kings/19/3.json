    {
      "kind": "idiom",
      "subject": "मशबेर",
      "rationale": "मूल: ‘तोड़े के जगह’ — गर्भ के मुँह जहाँ से बच्चा बाहर फूटऽ हइ; जनम के कठिन घड़ी के दृष्टान्त।"
    },
    {
      "kind": "addition",
      "subject": "बचलइ हे",
      "rationale": "मूल ‘बल नञ जनमे बर’ — मगही के धारा बर किरिया-पूरक जोड़ल गेल।"
    },
    {
      "kind": "mystery",
      "subject": "संकट-सूचना",
      "rationale": "राजा के सन्देस जान-बूझ के अधूरा छोड़ल गेल — यशआयाहू के बिनती बाट जोहऽ हइ।"
    }
  ],
  "translation": "आउ ओकनी ओकरा कहलन: एहन कहलन हिज्कियाहू — संकट आउ डाँट आउ अपमान के दिन हकइ ई दिन; काहे कि बच्चा ⟨पेट के मुहाना⟩ ले आ गेलन हइ, बाकि जनमे बर बल नञ बचलइ हे।",
