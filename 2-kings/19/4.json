    {
      "kind": "crux",
      "subject": "רב שקה",
      "rationale": "ई पद-नाम हकइ — ‘रब-शाके’ जस के तस रखल; किछु अनुवाद ओकर अरथ ‘पान परोसे बर मुखिया’ कइलक — ओ अनुमान हकइ।"
    },
    {
      "kind": "crux",
      "subject": "והוכיח",
      "rationale": "‘फैसला करतन \/ डाँटतन’ — किरिया के दू अरथ: शासन करना या बात के खंडन।"
    },
    {
      "kind": "you",
      "subject": "यशआयाहू",
      "rationale": "हिज्कियाहू के सन्देस नबी यशआयाहू के सीधे बिनती: ‘तूँ बिनती उठा’।"
    },
    {
      "kind": "addition",
      "subject": "जे बचल हे",
      "rationale": "हनिम्त्साआ के किरिया विशेषण — मगही के धारा बर अलग खण्ड में जोड़ल।"
    }
  ],
  "translation": "हो सकऽ हइ कि यहवे तोहर एलोहीम ⟨את⟩ रब-शाके के सब बात सुनतन, जेकरा ओकर मालिक अस्सूर के राजा पठौलक जीवत एलोहीम के गाली देवे बर, आउ ओ बात पर फैसला करतन जे यहवे तोहर एलोहीम सुनलन हइ; आउ तूँ बचे-खुचे लोग बर बिनती उठा।",
