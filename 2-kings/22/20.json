    {
      "kind": "idiom",
      "subject": "पुरखा सब के संग जोड़ल",
      "rationale": "मरे के सुख-संकेत — मौत के सीधा उल्लेख बिना।"
    },
    {
      "kind": "elision",
      "subject": "דבר",
      "rationale": "किरिया ‘लावलन’ में बात के आना मिल गेल; ‘बात’ संज्ञा रूप में रखल।"
    },
    {
      "kind": "you",
      "subject": "यहवे",
      "rationale": "वाचा के अंतिम बात राजा योशिया से — सुने का रिस्पॉन्स के घोसना।"
    }
  ],
  "translation": "एहे से देखऽ, हम तोहरा तोहर पुरखा सब के संग जोड़ लेतिये, आउ तूँ सांति से अपन कबर में जोड़ल जइतऽ; आउ जे बुराई हम एहि जगह पर लानतिये, ओकरा तोहर आँखी देखतइ नञ। आउ ऊ लोग ⟨את⟩ राजा के उत्तर लावलन।",
