    {
      "kind": "crux",
      "subject": "כרמל",
      "rationale": "'ताजा अनाज' बनाम 'कनी के साथ अनाज' (KJV) बनाम 'बगइचा के फल' — करमेल के पुरान अरथ विवादित हे।"
    },
    {
      "kind": "addition",
      "subject": "एक",
      "rationale": "वाक्य शुरू में 'एक' जोड़ल गेल — हिब्रू में सिर्फ वेइश्श हे, 'आउ-मनुस'।"
    }
  ],
  "translation": "आउ एक मनुस बाल-शालिशा से अइलन, आउ एलोहीम के मनुस के ले गेलन पहिला फल के रोटी — जऊ के बीस रोटी — आउ ताजा अनाज ओकर थैली में; आउ ओ कहलन — लोग के देवऽ हइ ताकि ओकनी खाइ करथिन।",
