    {
      "kind": "substitution",
      "subject": "המקום",
      "rationale": "'ओ जगह' — शाब्दिक रूप से 'जगह'; कुछ अनुवाद एकरा कोढ़ के जगह लेथिन आउ कुछ अभियोजक रूप से अस्पताल या नगर बूझाथे।"
    }
