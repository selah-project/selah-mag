    {
      "kind": "wordplay",
      "subject": "אדני \/ עלליהם",
      "rationale": "हजाएल के 'हमर मालिक' (בכה बर आदर) के जबाब में दूध पियावे बाला बुतरू के विध्वंस — आदर आउ निर्दयता के टकराव"
    }
