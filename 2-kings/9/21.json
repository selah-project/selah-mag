    {
      "kind": "substitution",
      "subject": "जोड़ऽ",
      "rationale": "אסר मूल रूप से 'जुड़ना\/बाँधना' हकइ — रथ के घोड़ा जोड़े के बात।"
    },
    {
      "kind": "addition",
      "subject": "हर एक अपन रथ में",
      "rationale": "איש ברכבו शाब्दिक 'आदमी ओकर रथ में' — दूनो राजा बर मगही में साफ करे के चाही।"
    },
    {
      "kind": "you",
      "subject": "यहोराम",
      "rationale": "रथ जोड़े के हुकुम ओकर सेवक के दने हकइ।"
    }
  ],
  "translation": "आउ यहोराम कहलन — जोड़ऽ। आउ ओकर रथ जोड़ल गेल। आउ यहोराम, यिस्राएल के राजा, बाहर अइलन, आउ अहज्याहू, यहूदा के राजा, हर एक अपन रथ में; आउ ओनी यहू के भेंट बर निकललन आउ ओकरा नाबोत यिज्रेली के खेत के हिस्सा में भेंटलन।",
