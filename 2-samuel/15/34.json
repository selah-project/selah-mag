    {
      "kind": "crux",
      "subject": "עבדך אני המलך אהיה",
      "rationale": "पुरान अनुवादन में 'हे राजा' के जगह बदल-बदल कइल गेलइ — कतक 'अबशालोम' के सम्बोधन, कतक 'तोहर बाप राजा' के अरथ।"
    },
