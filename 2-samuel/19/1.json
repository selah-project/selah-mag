  "notes": [
    {
      "kind": "wordplay",
      "subject": "בני...בני",
      "rationale": "बेटा आउ अबशालोम के पाँती बार-बार दोहरावल गेलै — शोक के लय, अनुवाद में गिनती जस के तस रखल गेलै।"
    },
    {
      "kind": "idiom",
      "subject": "מי יתן",
      "rationale": "शाब्दिक अर्थ 'कौन देता' — इच्छा व्यक्त करे वाली इब्रानी मुहावरा, 'काश कि'।"
    },
    {
      "kind": "addition",
      "subject": "हमरे भऽ होतइ",
      "rationale": "इच्छा स्पष्ट करे बदला हमनी के भाषा के क्रिया-रूप जोड़ल गेलै जे इब्रानी में नहीं है।"
    },
    {
      "kind": "you",
      "subject": "मृत अबशालोम से",
      "rationale": "राजा सीधा अपन मरल बेटा के संबोधित करैथन।"
    }
  ],
  "translation": "आउ राजा काँपि गेलन, आउ दुआरी के ओपरिला कोठरी पर चढ़लन, आउ रोवलन; आउ जाते-जाते एने कहलनका — हमर बेटा अबशालोम, हमर बेटा, हमर बेटा अबशालोम! कऊन देतइ ⟨कि⟩ हमर मौत हमरे भऽ होतइ तोहर जगह, अबशालोम, हमर बेटा, हमर बेटा!",
