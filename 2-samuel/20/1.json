    {
      "kind": "invitation",
      "subject": "हर आदमी अपन तम्बू दने जा",
      "rationale": "शेबा के पुकार यिस्राएल के सीधे बुलावा हकै — बिद्रोह के आह्वान।"
    },
    {
      "kind": "you",
