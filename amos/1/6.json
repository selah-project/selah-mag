    {
      "kind": "crux",
      "subject": "לא אשיבנו",
      "rationale": "शाब्दिक रूप से 'हम ओकरा फेर नञ बइलबइ' — 'माफ नञ करबइ' बनाम 'ओकरा फेर नञ जाबइ', दुनू पढ़ावै में चलनसार"
    },
    {
      "kind": "addition",
      "subject": "ओकरा",
      "rationale": "हिब्रू के क्रिया में पहले से जुड़ल प्रत्यय हकइ; मगही में अलग सर्बनाम जोड़ल गेल"
    },
    {
      "kind": "measurement",
      "subject": "तीन आउ चारि",
      "rationale": "अमोस के गिनती वाला ढाँचा — 'तीन बर आउ चारि' — हर फरमान के नेंव"
    }
  ],
  "translation": "एहने कहलन यहवे: अज्जा के तीन अपराध आउ चारि बर, हम ⟨ओकरा⟩ माफ नञ करबइ — काहे कि ओकनी पूरा बन्धुआ लोग के बन्धुआ बना के एदोम के हवाले करलन।",
