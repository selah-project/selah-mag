    {
      "kind": "crux",
      "subject": "मह שחו",
      "rationale": "‘ओकर सोच’ बनाम ‘ओकरा के ओकर सोच’ — ई यहवे के विचार हकइ या आदमी के, पुरान अनुवादकन में मतभेद।"
    },
    {
      "kind": "hapax",
      "subject": "שיחו",
      "rationale": "सिच के ई रूप तनाख़ में केवल इहै बर अबाद हकइ।"
    },
    {
      "kind": "wordplay",
      "subject": "שחר \/ עיפה",
      "rationale": "भोर आउ अन्हार के उलटा-जोड़ी — जे भोर लावैला हथिन ऊहे ओकरा अन्हार कर देथिन — अमोस के बिचार के चाल।"
    },
    {
      "kind": "substitution",
      "subject": "רוח",
      "rationale": "रूआख बतास हकइ; ‘आत्मा’ के अरथ में लेवऽ ओकर आकार के मेटावऽ हकइ।"
    }
  ],
  "translation": "काहे कि देखऽ, ऊ जे पहाड़ सब के गढ़ैला हथिन आउ रूआख के सिरजलन हथिन, आउ आदमी के ओकर सोच बतावैला हथिन, जे भोर के अन्हार बनैला हथिन आउ धरती के ऊँचा जगहन पर गोड़ धरैला हथिन — यहवे, त्सबाओत के एलोहीम, ओकर नाम हकइ।",
