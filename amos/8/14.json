    {
      "kind": "crux",
      "subject": "אשמת",
      "rationale": "तीन पढ़ि चलऽ हइ — 'शोमरोन के पाप', 'अपराध' (ashmath), या असीरियन देवी 'अशीमा' के नाम (2 राजा 17:30); हमनी 'अपराध' लेनी ऐ — ऊ दुनों अरथ के छोवऽ हइ।"
    },
    {
      "kind": "crux",
      "subject": "דרך באר שבע",
      "rationale": "'बेर-शेबा के रस्ता' — कुछु पढ़ि 'तीरथ के रस्ता' समझावऽ हइ, कुछु 'रीति-रिवाज'; मूल साफ नञ हकइ, इहाँ शब्द-निस्ठ 'रस्ता' रखल गेलइ।"
    },
    {
      "kind": "substitution",
      "subject": "देवता",
      "rationale": "אלהיך इहाँ दान के सुनर देवता बर हकइ — जाति-सब्द 'देवता' सही हकइ, नाम एलोहीम नञ।"
    },
    {
      "kind": "you",
      "subject": "शपथ खाय वाला लोग",
      "rationale": "उत्तर आउ दक्खिन दुनों तीरथ के संग जुड़ल लोग के दने सीधा बात।"
    }
  ],
  "translation": "जे शोमरोन के अपराध के संग शपथ खावऽ हथिन आउ कहऽ हथिन — “तोहर देवता जीवऽ हे, दान” आउ “बेर-शेबा के रस्ता जीवऽ हे” — ऊ गिर जातइ आउ फेर नञ उठतइ।",
