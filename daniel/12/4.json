      "subject": "बात बन्न, किताब छाप",
      "rationale": "बात सब जान-बूझ के छुपावल आउ सील करावल जा रहलइ — अंत के समय ले बन्न।"
    },
    {
      "kind": "mystery",
      "subject": "अंत के समय",
      "rationale": "खुलासा सील के पाछे रहलइ; पढ़निहार लेल ई बात जान-बूझ के रोकल हकइ।"
    },
    {
      "kind": "you",
      "subject": "दानिएल के",
      "rationale": "सीधा दानिएल के आज्ञा — बात सब बन्न करऽ।"
    },
    {
      "kind": "crux",
      "subject": "ישטטו",
      "rationale": "'इधर-उधर दौड़ल' बनाम 'पढ़े बर खोज करल' — दोनो पढ़ाव के परम्परा में चलन हकइ।"
    }
  ],
  "translation": "आउ तूँ दानिएल, बात सब बन्न कर आउ किताब के छाप लगा, अंत के समय ले; ढेर लोग इधर-उधर दौड़तन आउ जानकारी बढ़तइ।",
