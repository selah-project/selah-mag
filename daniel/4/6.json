    {
      "kind": "secret",
      "subject": "רז",
      "rationale": "राजा कहऽ हकइ कि कोनो राज-बात (רז) दानियेल के नञ रुकावऽ हकइ — गुप्त ज्ञान के बिसय।"
    },
    {
      "kind": "addition",
      "subject": "हे",
      "rationale": "मगही सम्बोधन बर हे जोड़ल गेलइ; इब्रानी (अरामाई) में खाली नाम हकइ।"
    }
  ],
  "translation": "हे बेल्तेशात्सर, जादूगर सब के मुखिया, काहे कि हम जानने हइ कि तोहरा में पवित्तर एलोहीम के रूआख हकइ आउ कोनो गुप्त बात तोहरा नञ परेसाने — तोहनी हमरा सुपना के दरसन बतावऽ जे हम देखलियै आउ ओकर मतलब।",
