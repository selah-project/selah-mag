    {
      "kind": "substitution",
      "subject": "אסר",
      "rationale": "‘हुक्म’ देलन गेलइ; मूल अरमाइक अरथ हकइ ‘रोक-लगान’ — देवता या मनुस से माँग के रोक।"
    },
    {
      "kind": "substitution",
      "subject": "לגוב",
      "rationale": "गड्ढा — खुदाए हुए गर्त-गड्ढा; ‘सेर के बाड़ी’ नञ, काहे कि गड्ढा खुदायल चीज हकइ।"
    },
    {
      "kind": "elision",
      "subject": "הלא",
      "rationale": "हल-प्रस्न के चिन्हा — सवाल के रूप में पिघर गेलइ, अलग शब्द ‘की’ में मिल गेलइ।"
    },
    {
      "kind": "you",
      "subject": "साजिशी राजा के आगे",
      "rationale": "सीधा राजा से सवाल — ‘की राजा हुक्म नञ लिखल हथिन?’"
    }
  ],
  "translation": "तब ओकनी नजदीक अइलन आउ राजा के आगे राजा के हुक्म के बारे में कहलन: की राजा हुक्म नञ लिखल हथिन जे हर कोनो मनुस जे कोनो देवता या मनुस से तीस दिन ले बिनती माँगऽ हइ, तोहारे से छोड़ के, ओकरा सेरन के गड्ढा में डारल जातइ? राजा जबाब देलन आउ कहलन: बात पक्का हइ, मादय आउ पारस के दात के मोताबिक, जे बदली नञ होवऽ हइ।",
