    },
    {
      "kind": "mystery",
      "subject": "दर्सन",
      "rationale": "जानवर के दर्सन जान-बूझ के रहस्यमय छवि हकइ जेकर अरथ वाला अभी खोलल नञ गेलै।"
    }
