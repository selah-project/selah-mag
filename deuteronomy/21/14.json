    {
      "kind": "idiom",
      "subject": "לנפשה",
      "rationale": "अक्षरसः 'ओकर परान खातिर' — 'जहाँ ओकर मन करऽ हइ' के ढंग।"
    },
    {
      "kind": "crux",
      "subject": "תתעמר",
      "rationale": "'दास जइसन दबावै' — किसान 'बेच के व्यापार करै' बनाम 'तानाशाही करै'; जड़ ढेर धरे के अरथ।"
    },
    {
      "kind": "substitution",
      "subject": "עניתה",
      "rationale": "'दुःख देलऽ हइ' — अक्षरसः 'ओकरा दबाइल अथवा नीच कइल'।"
    }
  ],
  "translation": "आउ होतइ अइसन: जे तूँ ओकरा मन नञ करऽ हइ, त ओकरा ओकर मन के मोताबिक छोड़ देबइ; बाकि बेचल नञ — ओकरा चानी में बेचबइ नञ — ओकरा के दास जइसन नञ दबाइ रखबइ, काहे कि तूँ ओकरा दुःख देलऽ हइ।",
