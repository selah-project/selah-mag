  "notes": [
    {
      "kind": "hapax",
      "subject": "קטב",
      "rationale": "'बरबादी' — ई सब्द पूरा तनाख़ में कोनो जगह नञ आवऽ हइ (कोनो अन्य स्थान पर नञ); बिना बतावले तस्वीर अस्पष्ट हकइ।"
    },
    {
      "kind": "hapax",
      "subject": "מרירי",
      "rationale": "'कड़वा' — ई रूप तनाख़ में केवल एही पद में आवऽ हइ।"
    },
    {
      "kind": "crux",
      "subject": "רשף",
      "rationale": "'अंगारा-बिजुरी' — ज्वलंत अंगारा या बिजुरी, बिना याद दिलावे कि इ प्राचीन देवता के नाम भी हकइ; 'तपन' बनाम 'महामारी' के अनुवादकीय विवाद।"
    },
    {
      "kind": "substitution",
      "subject": "חמת",
      "rationale": "'बिख' — मूल शब्द 'गरमी\/गुस्सा' हकइ; साँप के बिख के ज्वाला वाला तस्वीर, 'बिख' एकरा के बाहरी रूप में देखावऽ हइ।"
    }
  ],
  "translation": "भूख से दुर्बल, आउ अंगारा-बिजुरी से खाइल, आउ कड़वा बरबादी; आउ पसु के दाँत हम ओकनी पर भेजबइ, धूरी के रेंगै वाला के बिख संग।",
