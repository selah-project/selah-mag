    {
      "kind": "you",
      "subject": "जवान",
      "rationale": "पूरा पद जवान के सीधा सम्बोधन हकइ — आज्ञा आउ चेतावनी दुनों।"
    },
    {
      "kind": "invitation",
      "subject": "खुस होव",
      "rationale": "आज्ञार्थ किरिया पढ़निहार के जवानी के आनन्द के दने बलावऽ हइ।"
    },
    {
      "kind": "crux",
      "subject": "במשפט",
      "rationale": "नियाव — कोनो अनुवाद 'दण्ड' बतावऽ हइ; मिश्पात के साफ अरथ 'फैसला\/नियाव' हकइ।"
    }
  ],
  "translation": "खुस होव जवान तोहर बचपन में, आउ तोहर हिरदय तोहनी भला करऽ तोहर जवानी के दिन में, आउ चलऽ तोहर हिरदय के रस्ता में आउ तोहर आँखी के देखाई में; बाकि जान ले कि ए सब बर एलोहीम तोहनी नियाव में लएतन।",
