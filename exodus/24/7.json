    {
      "kind": "addition",
      "subject": "हमनी",
      "rationale": "इब्रानी में करता छिपल हे — 'नेअसेह' ('करब') पहिले बचन-बहुबचन क्रिया में; मगही के करता चाही।"
    },
    {
      "kind": "crux",
      "subject": "נעשה ונשמע",
      "rationale": "'करब आउ सुनब' — क्रम बहस के बिसय: ओकनी पहिले करे के बचन देलन हे आउ फेर सुनब, या 'सुनब' के मतलब 'मानब'।"
    },
    {
      "kind": "you",
      "subject": "लोग के कान में",
      "rationale": "पढ़ावे के काम सीधे लोग के सामने कइल गेल — परजा खुद बचन देलक।"
    }
  ],
  "translation": "आउ ऊ वाचा के किताब लेलन आउ लोग के कान में पढ़के सुनालन, आउ ओकनी कहलन: “जे कुछ यहवे कहलन हे ऊ सब ⟨हमनी⟩ करब आउ ⟨हमनी⟩ सुनब।”",
