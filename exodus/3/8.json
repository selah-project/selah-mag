    {
      "kind": "idiom",
      "subject": "दूध आउ मध बहै वाला धरती",
      "rationale": "זבת חלב ודבש — बहै के चित्र जस के तस रखल गेल, काहे कि ई तनाख़ के स्थिर मुहावरा हकइ।"
    },
    {
      "kind": "measurement",
      "subject": "छह जाति के सूची",
      "rationale": "कनानी से यबूसी तक जाति-सूची — कनान के लोगन के नाम-गिनती।"
    },
    {
      "kind": "addition",
      "subject": "हम",
      "rationale": "וארד में कर्ता सर्बनाम जोड़ल गेल — मगही के जंतरचाल चाही।"
    }
  ],
  "translation": "आउ हम उतरलन — ओकरा मिस्रयिम के हाथ से छुड़ावे बर, आउ ओकरा ओ धरती से उठावे बर, एक बढ़िया आउ चउड़ा धरती में, दूध आउ मध बहै वाला धरती में — कनानी, आउ हित्ती, आउ एमोरी, आउ परिज्जी, आउ हिव्वी, आउ यबूसी के जगह में।",
