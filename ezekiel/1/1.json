    {
      "kind": "measurement",
      "subject": "तीस बरिस \/ चारथा महीना \/ पाँचवा",
      "rationale": "पद पहिला पढ़निहार के दिन-गिनती से ठाढ़ हऽ है — विजन के समय पिन कइल गेलहै।"
    },
    {
      "kind": "crux",
      "subject": "तीस बरिस",
      "ratioale": "ककर उमिर — यहेजकेल के या राजा योयाखिन के बन्धकता के — ई पुरान कुरसी हकै।"
    }
  ],
  "translation": "आउ ई होलइ तीस बरिस में, चारथा महीना में, महीना के पाँचवा ⟨दिन⟩, आउ हम बन्धक-परजा के बीच में छेबार नदी के किनारा रहलियै, तब अकास खुललन आउ हम एलोहीम के दरसन देखलियै।",
