    {
      "kind": "addition",
      "subject": "⟨बोझ⟩",
      "rationale": "इब्रानी खाली 'काँध पर उठायतइ' कहऽ हइ; बोझ आगे के कथा से समझल जातइ — जोड़ल गेलइ स्पस्टता बर।"
    },
    {
      "kind": "elision",
      "subject": "אשר",
      "rationale": "दोसर אשर के मगही में अलग रूप नञ मिलल; ⟨संबंध-सब्द⟩ बाक्य-बनावट में घुसल रहल।"
    },
    {
      "kind": "you",
      "subject": "जेदिकिय्याहू-नेता बर",
      "rationale": "यहवे के बचन यरूशलयिम के नेता के बारे में हकइ, पर सुनैत बर जतना।"
    }
  ],
  "translation": "आउ ऊ नेता जे ओकनी के बीच में हथिन, अन्हार में काँध पर ⟨बोझ⟩ उठायतइ आउ बाहर निकलतइ; दीवार में ⟨ओकनी⟩ कोटर काटतन ताकि ओकरा ओकरे जरे बाहर करथिन; ऊ ⟨आपन⟩ मुँह ढाँकतइ, काहे कि ऊ आँख से ⟨את⟩ धरती के नञ देखतइ।",
