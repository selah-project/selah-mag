    {
      "kind": "idiom",
      "subject": "तोहर मूड़ी पर",
      "rationale": "על ראש इब्रानी मुहावरा हकइ — कएल काम के फल वापिस पावऽ; शाब्दिक रूप रखलन।"
    },
    {
      "kind": "crux",
      "subject": "ई खोट काम",
      "rationale": "अंतिम कड़ी — ולא עשית 'तूँ कइलक नञ' बनाम JPS प्रस्न 'का तूँ कइलक नञ?' — इब्रानी पाठ वाक्य-रूप में देतइ।"
    },
    {
      "kind": "wordplay",
      "subject": "דרכך...בראש",
      "rationale": "तोहर डहर के तोहर मूड़ी पर — करम आउ बदला के जोड़ी, मगही में ढेर बचावल।"
    },
    {
      "kind": "you",
      "subject": "यरूशलयिम",
      "rationale": "पूरा पद ओकरा संबोधित हकइ।"
    }
  ],
  "translation": "काहे कि तूँ ⟨את⟩ अपन जवानी के दिन के याद नञ रखलक, आउ ए सब बात में हमरा कोप देलक; तइसे देखऽ — हमहोँ तोहर करतूत तोहर मूड़ी पर धरलन — अदोनाय यहवे के बचन — आउ तूँ ए सब घिनौना काम के ऊपर ई खोट काम नञ कइलक।",
