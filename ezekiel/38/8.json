    {
      "kind": "crux",
      "subject": "תפקד",
      "rationale": "'हाजिर करल जातइ' — पकद किरिया के दू अरथ: दोस्ती से भेंट या फौज जुटावल जाना; KJV 'visited', JPS 'mustered'"
    },
    {
      "kind": "measurement",
      "subject": "समय",
      "rationale": "'बहुत दिन के बाद', 'बरिसन के अंत में' — समय के गिनती-माप"
    },
    {
      "kind": "you",
      "subject": "गोग",
      "rationale": "यहवे गोग से सीधा बात — ओकर आगमन के भबिस बतावल गेलइ हइ"
    },
    {
      "kind": "substitution",
      "subject": "फेर-आवल",
      "rationale": "משובבत शूब जड़ के हकइ — 'फेर आवल\/बहाल करल'; कइटो अनुवाद 'तलवार से उबारल' जइसन अरथ लेतन"
    }
  ],
  "translation": "बहुत दिन के बाद तोहरा हाजिर करल जातइ; बरिसन के अंत में तूँ अइबइ अइसन धरती में जे तलवार से फेर-आवल हइ, ढेर जाति के लोग से जुटावल गेलइ हइ, यिस्राएल (इस्राएल) के पहाड़ पर, जे लगातार उजाड़ हलन; आउ ऊ जाति के लोग से बाहर करल गेलन, आउ ओकनी सब निश्चिन्त बसबइ।",
