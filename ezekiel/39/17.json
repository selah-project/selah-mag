    {
      "kind": "invitation",
      "subject": "हिकाबत्सु-हेआस्फु",
      "rationale": "चिरईं आउ जीव-जंतु के तीन आज्ञा-क्रिया — पाठ ओकनी के सीधे बुलावऽ हइ।"
    },
    {
      "kind": "you",
      "subject": "आदमी के बेटा",
      "rationale": "यहवे अपन नबी के सीधे सम्बोधन करऽ हइ।"
    },
    {
      "kind": "wordplay",
      "subject": "זבחי…זבח…זבח",
      "rationale": "ज-ब-च जड़ तीन बेर दोहरावल — बलि के दृश्य हर दोहराव में गाढ़ होवऽ हइ।"
    },
    {
      "kind": "crux",
      "subject": "זבח = बलि बनाम भोज",
      "rationale": "JPS 'feast' कहऽ हइ, क्योंकि चिरईं के बलि करावे नञ; बाकि जड़ के स्वरूप 'बलि\/वध' हकइ।"
    }
  ],
  "translation": "आउ तूँ, आदमी के बेटा, अइसने कहलन अदोनाय यहवे: चिरईं के हर पंखा से आउ खेत के हर जीव-जंतु से कह — जुड़ऽ, अइऽ, चारो दने से हमर ओ बलि पर जुड़ऽ जे हम तोहनी बर करऽ हइ, एक बड़ बलि यिस्राएल के पहाड़ पर; आउ तोहनी मांस खाबऽ आउ खून पीबऽ।",
