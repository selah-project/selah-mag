    {
      "kind": "crux",
      "subject": "במותם",
      "rationale": "बामोत (ऊँच जगह, पूजा के टीला) बनाम 'बमोतम' के दोसर पढ़ाई 'ओकनी के मौत में' — BSB 'funeral offerings' ओकरासे गढ़ल हकइ"
    },
