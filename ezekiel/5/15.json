    {
      "kind": "crux",
      "subject": "מוסר",
      "rationale": "'सबक\/ताड़ना' बनाम 'चिन्हा-उदाहरन' — जाति सब बर चेतावनी या आगू के बर ताड़ना, दूनो पढ़ाव मिलल।"
    }
