    {
      "kind": "crux",
      "subject": "הזמורה אל אפם",
      "rationale": "डाँटी के नाक लिख धइले — कत्तूब में नाक बहु-बचन (אפם) हइ; डाँटी अरथ में सुगन्ध-पूजा या सूरज-पूजा के चिन्हा लगावल जा हइ, पर पूरा अरथ बिबादित हकइ"
    },
    {
      "kind": "substitution",
      "subject": "अפם",
      "rationale": "אף मूल रूप में नाक\/नथुने हकइ; क्रोध के अरथ सुगन्ध-बिग्यान में बाद में आवऽ हइ — इहाँ शरीर के नाकए अरथ हकइ"
    },
    {
      "kind": "you",
      "subject": "यहेजकेल के",
      "rationale": "मनुस के बेटा के सीधा सम्बोधन — हे देखलऽ हऽ"
    }
  ],
  "translation": "आउ ऊ हमरा कहलन — देखलऽ हऽ, मनुस के बेटा? का यहूदा के घर बर ओकनी के इहाँ ई ⟨את⟩ घिनावना काम करना पसिन्ना हकइ जे ओकनी करलन? काहे कि ओकनी ⟨את⟩ धरती के हिंसा से भर देलन, आउ फेर हमरा क्रोध दिए लिख अइलन — आउ देखऽ, ओकनी ⟨את⟩ डाँटी अपन नाक लिख धइले हथिन!",
