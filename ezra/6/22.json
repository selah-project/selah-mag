    {
      "kind": "crux",
      "subject": "असूर के राजा",
      "rationale": "एहि समय के राजा दारयावेस फारस के हलथिन; असूर एहाँ पुरान साम्राज्य के नाम से पूरब के सत्ता बर गिनाहइ — कुछु अनुवादक एकरा बेबीलोन-विरासत के रूप मानऽ हथिन"
    },
    {
      "kind": "wordplay",
      "subject": "שמחה\/שमחם",
      "rationale": "खुसी आउ खुस करलन — एके जड़ के दोहराव, मगही में आंशिक रूप से बचल"
    },
    {
      "kind": "idiom",
      "subject": "हाथ मजबूत करना",
      "rationale": "इब्रानी मुहावरा — ताकत देना, हौसला बढ़ावना"
    }
  ],
  "translation": "आउ ओनी मैदा के परब सात दिन खुसी से मनइलन, काहे कि यहवे ओनी के खुस करलन हल, आउ असूर के राजा के हिरदय ओनी के दने घुमा देलन हल, यिस्राएल के एलोहीम के घर के काम में ओनी के हाथ मजबूत करे बर।",
