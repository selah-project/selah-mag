    {
      "kind": "addition",
      "subject": "हकइ",
      "rationale": "इब्रानी (अरामी) में क्रिया-सम्बन्ध नञ हकइ; मगही के बाक्य एकरा माँगऽ हइ।"
    },
    {
      "kind": "you",
      "subject": "एज्रा के",
      "rationale": "अर्तहशस्ता के चिट्ठी सीधे एज्रा के बोल रहलइ हे — आदेश के रूप में।"
    },
    {
      "kind": "crux",
      "subject": "ותקרב",
      "rationale": "अर्थ 'चढ़ाबऽ' बनाम 'ओकरा पास अनऽ' — पिठोनiel चढ़ावै के काम बुझाऽ हइ।"
    }
  ],
  "translation": "एही कारण एहि चानी से तूँ पूरा जतन से बैल, मेढ़ा आउ मेमना खरीदऽ, आउ ओकनी के मिन्हा आउ ओकनी के पियै के बलि, आउ ओकनी के तोहर एलाह के घर के बेदी ऊपर चढ़ाबऽ — ओ घर यरूशलयिम (यरूशलेम) में हकइ।",
