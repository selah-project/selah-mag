    {
      "kind": "idiom",
      "subject": "באכה",
      "rationale": "'जाते-जाते' — मूल 'तोहरा आवे पर' (as thou comest) के चलनसार चित्र; मगही में बतावे-बाला डहर के बहुवचनी चाल।"
    },
    {
      "kind": "measurement",
      "subject": "सीमा-विवरण",
      "rationale": "कनान के सीमा के नाप — जगह के नाम के संग ले-तक के गिनती।"
    },
    {
      "kind": "crux",
      "subject": "עזה",
      "rationale": "अज्जा (गाजा) — इब्रानी नाम 'अज्जा' रखल गेलइ, चलनसार 'गाजा' नञ।"
    }
  ],
  "translation": "आउ कनानी के सीमा त्सिदोन से गेरार के ओर जाते-जाते अज्जा ले, आउ सदोम आउ अमोरा आउ अदमा आउ त्सबोइम के ओर जाते-जाते लेसा ले तक हलइ।",
