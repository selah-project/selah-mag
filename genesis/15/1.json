    {
      "kind": "wordplay",
      "subject": "הדברים \/ דבר",
      "rationale": "बातन के बाद बचन — एके जड़ के दोहराव, इब्रानी के जुड़ाव"
    },
    {
      "kind": "you",
      "subject": "अवराम के",
      "rationale": "यहवे सीधे अवराम के सम्बोधन करऽ हइ — डर-मत के आज्ञा"
    }
  ],
  "translation": "ई बातन के बाद यहवे के बचन दर्शन में अवराम (अब्राम) ला आइल, कहऽ हइ — मत डर अवराम, हम तोहर ढाल ⟨हइ⟩, तोहर इनाम बहुते ढेर ⟨हकइ⟩।",
