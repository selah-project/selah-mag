    {
      "kind": "idiom",
      "subject": "ידעו איש",
      "rationale": "'मरद के जानना' — इब्रानी के इडिम बिआह बर; मगही में साफ रखल गेलइ।"
    },
    {
      "kind": "wordplay",
      "subject": "בצל קרתי",
      "rationale": "'हमर छत के छाँह' — छत के छाँह तले आवे के मतलब मेहमान के रक्षा; छाँह के मूल अरथ बचावल गेलइ।"
    },
    {
      "kind": "you",
      "subject": "सदोम के मरद सब के",
      "rationale": "लूत अपन दुआरी के मरद सब से सीधा बोलऽ हइ।"
    },
    {
      "kind": "elision",
      "subject": "נא",
      "rationale": "'अइसन चुकावऽ' से गुजारिश के भाव देल गेलइ; इब्रानी के नरम किरिया-चिन्हा के सुभाविक मगही रूप।"
    }
  ],
  "translation": "देखऽ, हमरा दू बेटी हइ जे अबहिन कोनो मरद के नञ जानथिन; अइसन चुकावऽ कि हम ओकनी के ⟨את⟩ तोहनी सब के बाहर निकाली दिअइ, आउ तोहनी ओकनी के संग ओहे करऽ जे तोहनी के आँख में ठीक लागऽ हइ; बाकि एहन मरद सब के संग कुछो मत करऽ, काहे कि एहे से ऊ ओकर छाँह तले हमर छत के छाँह तले अइलन हथिन।",
