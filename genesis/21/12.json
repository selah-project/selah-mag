    {
      "kind": "crux",
      "subject": "יקרא לך זרע",
      "rationale": "'तोहर बिया गढ़ल जातइ' — 'कहल जातइ' (नाम रखल जाव) बनाम 'गिनल जातइ' (बिया के रेखा यित्सहाक में गढ़ल जातइ) के विकल्प।"
    },
    {
      "kind": "idiom",
      "subject": "בעיניך",
      "rationale": "'तोहरी आँख में बुरा' — इब्रानी के इडियम, दुःख\/नाराजगी बर।"
    },
    {
      "kind": "you",
      "subject": "अवराहाम",
      "rationale": "एलोहीम अवराहाम से सीधे सम्बोधन करऽ हइ — आज्ञा आउ आश्वासन के बात।"
    },
    {
      "kind": "substitution",
      "subject": "זרע",
      "rationale": "बिया — बिया\/संतति दुनो अरथ में; इहाँ संतान के अरथ प्रमुख हकइ।"
    }
  ],
  "translation": "आउ एलोहीम अवराहाम से कहलन — ओ बुतरू बर आउ तोहरी दासी बर तोहरी आँख में बुरा मत लागऽ; जे कुछो सारा तोहसे कहतइ, ओकर बोली सुनऽ; काहे कि यित्सहाक (इसहाक) में तोहर बिया गढ़ल जातइ।",
