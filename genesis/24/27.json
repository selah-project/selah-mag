  "notes": [
    {
      "kind": "addition",
      "subject": "होवऽ",
      "rationale": "इब्रानी के बरकत शब्द के रूप में मगही में क्रिया शब्द की आवश्यकता है"
    },
    {
      "kind": "substitution",
      "subject": "असीस",
      "rationale": "ברוך के शाब्दिक अर्थ है 'घुटने टेकना' — यहाँ इसे आशीर्वाद के रूप में प्रयोग किया गया है"
    },
    {
      "kind": "crux",
      "subject": "מעם אדני",
      "rationale": "'अपने स्वामी के पास से नहीं छोड़ा' बनाम 'अपने स्वामी को नहीं छोड़ा' — के एजेंट की अस्पष्टता"
    },
    {
      "kind": "wordplay",
      "subject": "חסד ואמת",
      "rationale": "हेसेद-सच की जोड़ी — वफादार प्रेम और विश्वसनीयता का स्थायी जोड़ा, जिसे मगही में दो शब्दों से व्यक्त किया गया है"
    }
  ],
  "translation": "आउ ऊ कहलक — असीस होवऽ यहवे के, हमर मालिक अवराहाम के एलोहीम के, जे अपन हेसेद आउ अपन सच हमर मालिक से नञ छोड़लक; हम त रस्ता में रहलियइं, यहवे हमरा हमर मालिक के भाय लोगन के घर लानलन।",
