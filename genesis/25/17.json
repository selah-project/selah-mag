    {
      "kind": "idiom",
      "subject": "अपन लोग के संग जोड़ल गेलइ",
      "rationale": "אל עמיו — मरे के बाद अपन पूरबज के संग जुड़ल के इब्रानी चलन के बात हकइ।"
    },
    {
      "kind": "crux",
      "subject": "विगוע",
      "rationale": "गैवा — साँस छोड़लक; कइयन अनुवाद 'परान अलग कइलक' जइसन रूप दे हथिन।"
    }
  ],
  "translation": "आउ ई हथिन यिश्माएल (इस्माइल) के जिये के बरिस: सौ बरिस आउ तीस बरिस आउ सात बरिस; आउ ऊ साँस छोड़लक आउ मर गेलक आउ ओकरा ओकर लोग के संग जोड़ल गेलइ।",
