    {
      "kind": "elision",
      "subject": "אם",
      "rationale": "עד אשר इम के मुहावरे में इम सुद्ध-मजबूती के चिन्हा हए; मगही में ओकर अलग रूप नञ रहल"
    },
    {
      "kind": "addition",
      "subject": "हमनी",
      "rationale": "עמך के बाक्य में मगही के क्रिया चाही; इब्रानी क्रिया बिनु परति कहऽ हए"
    },
    {
      "kind": "you",
      "subject": "याकोव",
      "rationale": "यहवे के सहोता आउ वाचा के बात सीधे याकोव से कहल गेलन हए"
    }
  ],
  "translation": "आउ देखऽ हे, हम तोहनी के संग हमनी, आउ जे-जगह तूँ जाबऽ ओकर सब में हम तोहनी के रखवारी करबन, आउ हम तोहनी के एहे धरती में फेर ल अइबन; काहे कि जब तक हम ⟨את⟩ ओकरा नञ कर लबन जे हम तोहनी से कहलन हमनी, तब तक हम तोहनी के नञ छोड़बन।",
