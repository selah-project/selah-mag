  "notes": [
    {
      "kind": "addition",
      "subject": "⟨हकइ⟩",
      "rationale": "तिसरा बाक्यांस में क्रिया इब्रानी में नञ हकइ (हוא छोड़ के); मगही के बाक्य बर जोड़ल गेलइ।"
    },
    {
      "kind": "wordplay",
      "subject": "תאוה \/ ונחמד",
      "rationale": "लालसा आउ चाहल जाए वाला — दू जड़ के अरथ-मेल, अनुवाद में ओकर गूँज कम हो जाऽ हइ।"
    },
    {
      "kind": "measurement",
      "subject": "तीन लालसा के तौल",
      "rationale": "गाछ के तीन आँख से देखल गेलइ — खाए बर भला, देखे में लालसा, समझ पावे बर चाह — गिनल सूची जइसन बनावट।"
    }
  ],
  "translation": "आउ जनाना देखलइ कि गाछ खाए बर भला हकइ, आउ कि ऊ आँख बर लालसा ⟨हकइ⟩, आउ गाछ समझ पावे बर चाहल जाए वाला हकइ; तखनी ऊ ओकर फल लेलक आउ खइलक, आउ अपन संग रहल अपन मरद के भी देलक, आउ ऊ खइलक।",
