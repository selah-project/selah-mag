    {
      "kind": "crux",
      "subject": "הנשה",
      "rationale": "ई नस के नाम 'सिकुड़ल' कहलक — कोनो खास नस (साइटिका या अउर) कोनो पढ़निहार नञ जानऽ हइ; मगही में 'सिकुड़ल नस' रखल गेल।"
    },
    {
      "kind": "wordplay",
      "subject": "גיד הנשה",
      "rationale": "הנשה अपने एहे घटना से पड़ल नाम हकइ — 'जे सिकुड़ गेल' — एकर खेल इब्रानी में नाम के जड़ में हकइ।"
    },
    {
      "kind": "addition",
      "subject": "ऊ",
      "rationale": "כי नגע के करता इब्रानी में नञ नामलक हकइ; मगही के बाक्य बनावे बर ⟨ऊ⟩ जोड़ल गेल।"
    },
    {
      "kind": "you",
      "subject": "पढ़निहार बर रिवायत",
      "rationale": "पद आज तक चलत रिवायत के मूल बतावऽ हइ — कथा के सुनावे वाला पढ़निहार के संस्कृति के दुआरी में ले आवऽ हइ।"
    }
  ],
  "translation": "एहे से यिस्राएल (इस्राएल) के बेटा लोग आज तक ⟨את⟩ ओ सिकुड़ल नस नञ खाय लेथिन जे जाँघ के खोखरा भाग पर हकइ — काहे कि ऊ याकोव (याकूब) के जाँघ के खोखरा भाग के ओ सिकुड़ल नस में छु लेलन।",
