    {
      "kind": "idiom",
      "subject": "מתי מספר",
      "rationale": "शब्द-शब्द 'आदमी गिनती के' — मतलब गिनती में थोड़े; अनुवाद में 'गिनती के थोड़े' रखल गेल"
    },
    {
      "kind": "wordplay",
      "subject": "עכרתם",
      "rationale": "עכר ('परेसान करना') शब्द एही घराना के नाँव अकोर (1 इतिहास 2:7) से जुड़ल हइ — मगही में ई जोड़ बिना रह जाऽ हइ"
    },
    {
      "kind": "measurement",
      "subject": "मति मस्पर",
      "rationale": "आदमी के गिनती के बात — थोड़ होने के गिनती"
    },
    {
      "kind": "you",
      "subject": "शिमोन आउ लेवी के",
      "rationale": "याकोव अपन दू बेटा के सीधा सम्बोधन करऽ हथिन"
    }
  ],
  "translation": "तब याकोव (याकूब) शिमोन आउ लेवी के कहलन — तोहनी हमरा ⟨את⟩ बदबू बना देलहुँ ओ धरती के रहेबइया — कनानी आउ परिज्जी — के बीच में; आउ हम त गिनती के थोड़े आदमी हिअए, ओकनी हमरा ऊपर जुट जतइन आउ हमरा मार देतइन, आउ हम नास हो जतिए — हम आउ हमर घर।",
