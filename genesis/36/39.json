    {
      "kind": "addition",
      "subject": "हलइ",
      "rationale": "इब्रानी में क्रिया नञ हइ; मगही के बाक्य बर ⟨हलइ⟩ जोड़ल गेल।"
    },
    {
      "kind": "elision",
      "subject": "בעל חנן · מי זהב",
      "rationale": "हर नाम के दू टोकन एक्के लिखाई में मिलानल — दोहराव से बचे बर।"
    },
    {
      "kind": "measurement",
      "subject": "नाम के सूची",
      "rationale": "राजा के नगर आउ वंसावली के नाम गिनावल गेल हइ।"
    },
    {
      "kind": "crux",
      "subject": "הדר",
      "rationale": "केजेवे\/एसवी हदर; लिसेपु\/बीएसबी हदद पढ़ऽ हइ — अच्छर के फरक।"
    }
  ],
  "translation": "आउ अकबोर के बेटा बाल-चनन मर गेलन, आउ ओकरा जगह हदर राज करलन, आउ ओकर नगर के नाम पाऊ ⟨हलइ⟩, आउ ओकर जनाना के नाम महेताबेल ⟨हलइ⟩ — मतरेद के बेटी, मे-जहब के बेटी।",
