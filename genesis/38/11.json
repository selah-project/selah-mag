    {
      "kind": "you",
      "subject": "यिहूदा के बात तामार से",
      "rationale": "सीधा सम्बोधन — आज्ञा आउ ओखनी के भबिस के बात।"
    },
    {
      "kind": "invitation",
      "subject": "שבי אלמנה",
      "rationale": "तामार के देल गेल आज्ञा — बुढ़िया बनल रहऽ के हुक्म।"
    },
    {
      "kind": "substitution",
      "subject": "אלמנה",
      "rationale": "'बुढ़िया बनल' — मगही में सुभाविक; 'विधवा' संस्कृत-भारी रूप हइ।"
    },
    {
      "kind": "substitution",
      "subject": "רעהו छोड़ אמר",
      "rationale": "'काहे कि ओखनी कहलन' — मूलपाठ 'काहे कि ओ कहलक' भी हो सकऽ हइ; अन्तर बतावल जातइ।"
    }
  ],
  "translation": "तब यिहूदा ओकर बहू तामार से कहलन — तोहर बाबूजी के घर में रान्ही बुढ़िया बनल रह, जब तक हमर बेटा शेला बड़ नञ हो जातइ — काहे कि ओखनी कहलन, कहीं ऊ भी ओकर भाय के नियर नञ मर जाय; आउ तामार गेलइ आउ ओकर बाबूजी के घर में रहलइ।",
