    {
      "kind": "idiom",
      "subject": "וינחם",
      "rationale": "शाब्दिक 'साँस लेलन \/ शोक में सांति पावलक' — मगही में 'मन बस गेलइ' कइल गेलइ।"
    },
    {
      "kind": "elision",
      "subject": "וחירה के 'आउ'",
      "rationale": "मूलपाठ के वाउ के 'आउ' ⟨आउ⟩ के रूप में देखावल गेलइ काहे कि मगही के जोड़-बनावट में ऊ जुड़ल रहऽ हइ।"
    },
    {
      "kind": "substitution",
      "subject": "תמנתה का कारक",
      "rationale": "'तिमना के' — मूलपाठ के -ה प्रत्यय दिशा-अरथ देतइ; मगही में कारक से देखावल गेलइ।"
    }
  ],
  "translation": "आउ दिन ढेर बीत गेलन; शूआ के बेटी, यिहूदा के जनाना के मौत हो गेलइ; आउ यिहूदा के मन बस गेलइ, आउ ऊ ओकर मेमना के ऊन काटए वाला के पास चढ़लन — ऊ ⟨आउ⟩ ओकर संगी खिरा, अदुल्लाम के राही — तिमना के।",
