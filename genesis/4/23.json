    {
      "kind": "you",
      "subject": "लेमेक के जनाना",
      "rationale": "लेमेक अपन जनाना अदा आउ त्सिल्लाह के सीधे सम्बोधन करऽ हइ — तनाख़ के पहिला गीत।"
    },
    {
      "kind": "invitation",
      "subject": "सुनऽ \/ कान लगावऽ",
      "rationale": "समानान्तर आज्ञा-युग्म — 'सुनऽ' आउ 'कान लगावऽ' — पढ़निहार के भी खींचऽ हइ।"
    },
    {
      "kind": "crux",
      "subject": "לפצעי \/ לחברתי",
      "rationale": "'हमर जख्म के बर' बनाम 'हमरे जख्म करै वाला के' — हिब्रू के संग-पद दुनों दने खुलल हइ।"
    },
    {
      "kind": "wordplay",
      "subject": "parallelism",
      "rationale": "मरद\/जवान बुतरू आउ जख्म\/खरोट के जोड़ी-वाक्य ढाँचा — मगही में ताल बचल हइ, ध्वनि-मेल नञ।"
    }
  ],
  "translation": "आउ लेमेक अपन जनाना सब के कहलन — अदा आउ त्सिल्लाह, हमर बोली सुनऽ; लेमेक के जनाना, हमर बात कान लगावऽ — काहे कि हम ⟨एक⟩ मरद के मार देलए हमर जख्म के बर, आउ ⟨एक⟩ जवान बुतरू के हमर खरोट के बर।",
