    {
      "kind": "wordplay",
      "subject": "חלום חלמנו",
      "rationale": "संज्ञा आउ किरिया एके जड़ के — 'सपना सपना-देखनी' — मगही में ई जोड़ी खतम हो जा हइ।"
    },
    {
      "kind": "crux",
      "subject": "पितरोनिम एलोहीम के",
      "rationale": "'की फेर एलोहीम के नञ हइ?' — हिब्रू 'एलोहीम के संग\/के बर' कहऽ हइ; कतुबा सब में ई दावा कइसन समझल जा हइ एही एक बड़ झगड़ा के जगह हकइ।"
    },
    {
      "kind": "invitation",
      "subject": "हमरी बेर हमरा बतावऽ",
      "rationale": "योसेफ के अनुरोध — सपना सुनावऽ के आग्रह — बात के आगू बढ़ावे के दुआरी।"
    },
    {
      "kind": "you",
      "subject": "योसेफ बन्दी अफसर सब के",
      "rationale": "पूरा पद सीधा बातचीत हकइ — पहिला ओकनी के जवाब, फेर योसेफ के प्रतिउत्तर।"
    }
  ],
  "translation": "आउ ओकनी ओकरा कहलन — सपना हमनी देखनी हइ, बाकि ⟨את⟩ ओकर फेर करे वाला कोनो नञ हइ। आउ योसेफ ओकनी के कहलन — की फेर करना एलोहीम के नञ हइ? हमरी बेर हमरा बतावऽ।",
