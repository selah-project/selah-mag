    {
      "kind": "invitation",
      "subject": "गशू ठा",
      "rationale": "योसेफ भाय सब के आपना लग बलावऽ हइ — 'हमरा लग आवू, जरा'।"
    },
    {
      "kind": "addition",
      "subject": "हिअए",
      "rationale": "אני יोसף में क्रिया नञ; मगही के जोड़ के रूप में कोस्ठक में।"
    },
    {
      "kind": "you",
      "subject": "भाय सब",
      "rationale": "सीधा सम्बोधन जारी — 'तोहनी के भाय, जेकरा तोहनी बेच देलक'।"
    }
  ],
  "translation": "आउ योसेफ आपन भाय सब से कहलन, “हमरा लग आवू, जरा।” आउ ओकनी लग अएलन; आउ ओ कहलन, “हम योसेफ ⟨हिअए⟩, तोहनी के भाय, जेकरा तोहनी ⟨את⟩ हमरा मिस्रयिम के बेच देलक।”",
