    {
      "kind": "crux",
      "subject": "מגורי",
      "rationale": "अस्थायी ठहराव बनाम स्थायी रहैत — 'रहे-ठहरे' दुनों छूवऽ हकइ।"
    },
    {
      "kind": "wordplay",
      "subject": "ימי שני",
      "rationale": "'बरिस के दिन' के तीन दोहराव — बुढ़े याकोव के गिनती वाली लय, मगही में अंशतः बचल।"
    },
