    {
      "kind": "addition",
      "subject": "महीना \/ दिन",
      "rationale": "बरאשורां आउ באחד के संग 'महीना' आउ 'दिन' के सब्द इब्रानी में नञ हकइ; कोस्ठक में देखावल गेल।"
    },
    {
      "kind": "wordplay",
      "subject": "חרבו ... חרבו",
      "rationale": "एके किरिया दू बेर — पानी के सूखल आउ धरती के तल के सूखल — बाक्य के बुनावट हकइ।"
    },
    {
      "kind": "measurement",
      "subject": "तारीख",
      "rationale": "बरिस, महीना आउ दिन के गिनती — बाढ़ के समय-पट्टी के नाप।"
    },
    {
      "kind": "substitution",
      "subject": "तल",
      "rationale": "פני (मुँह\/चेहरा) के धरती बर 'तल' धरल गेल; इब्रानी के तस्वीर — धरती के 'मुँह'।"
    }
  ],
  "translation": "आउ होलन एक आउ छः सौ बरिस में, पहिला ⟨महीना⟩ में, महीना के एक ⟨दिन⟩ में, पानी धरती के ऊपर से सूख गेलन; आउ नोआ नाव के छत ⟨את⟩ हटालक, आउ देखलक, आउ देखो — धरती के तल सूख गेलन।",
