    {
      "kind": "crux",
      "subject": "ויער",
      "rationale": "'जगा देलन' — कुछ अनुवाद 'उठालन\/हिला देलन'; जगैना जड़ के साफ चित्र।"
    },
    {
      "kind": "substitution",
