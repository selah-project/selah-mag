    {
      "kind": "idiom",
      "subject": "अपन मुँह पर बिगुल",
      "rationale": "אל חכך שפר शाब्दिक रूप से 'तालू के प्रति सिंगर' हकइ — चेतावनी देबे के आज्ञा, बिगुल बजावे के चित्र।"
    },
    {
      "kind": "crux",
      "subject": "चिल",
      "rationale": "נשר: 'चील\/गरुड़' बनाम 'गिद्ध' (JPS vulture) — शिकार करे वाला बड़ चिरईं, ओकर भविष्य के बात या अतीत की — विवादित।"
    },
    {
      "kind": "addition",
      "subject": "आवतइ",
      "rationale": "इब्रानी में क्रिया नञ हकइ; चिल के उड़ावे के चाल बतावे बर क्रिया जोड़ल गेल।"
    },
    {
      "kind": "you",
      "subject": "भविष्यद्वक्ता के संबोधन",
      "rationale": "बिगुल बजावे के आज्ञा कतु के तरफ हकइ — संभवतः भविष्यद्वक्ता या पहरेदार।"
    }
  ],
  "translation": "तोहर मुँह पर बिगुल — ऊ चिल जइसन यहवे के घर के ऊपर ⟨आवतइ⟩, काहे कि ओकनी हमर वाचा लाँघ देलन आउ हमर तोरा के विरुद्ध बगावत कइलन।",
