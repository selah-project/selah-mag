    {
      "kind": "elision",
      "subject": "לאमר",
      "rationale": "'कहऽ कि' क्रिया-विशेषण के कोनो साफ मगही रूप नञ — अर्धविराम से उद्धरण शुरू होलइ"
    },
    {
      "kind": "addition",
      "subject": "लोग",
      "rationale": "'बचल' संज्ञा बनावे बर मगही में संबोधन-सब्द जोड़ल गेलइ"
    },
    {
      "kind": "idiom",
      "subject": "मजदूर के बरिस जइसन",
      "rationale": "तय समय के गिनती — मजदूर के बरिस पूरा गिनल जा हइ; निश्चित मयाद के बात"
    },
    {
      "kind": "measurement",
      "subject": "तीन बरिस",
      "rationale": "बरिस के गिनती से मयाद तय होवऽ हइ"
    },
    {
      "kind": "alternative",
      "subject": "वनिकलה",
      "rationale": "'हल्का हो जइतइ' बनाम 'तुच्छ मानल जइतइ' — जड़ के सुभाविक अरथ 'हल्का' हकइ"
    }
  ],
  "translation": "आउ अब यहवे कहलन — तीन ⟨में⟩ बरिस, मजदूर के बरिस जइसन, मोआब के महिमा सब घना भीड़ के संग हल्का हो जइतइ; आउ बचल ⟨लोग⟩ बड़ी थोर, छोटहा, ताकतवार नञ होतइ।",
