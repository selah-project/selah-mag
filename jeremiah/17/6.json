    {
      "kind": "hapax",
      "subject": "ערער",
      "rationale": "तनाख में ई सब्द इहे रूप में कहुँ नञ मिलऽ हइ; झबरा-सुकखल गाछ के चित्र अनुमान पर टिकल हइ"
    },
    {
      "kind": "crux",
      "subject": "כי",
      "rationale": "'जब' बनाम 'कि' — देखतइ नञ कि बढिया बात अवतइ; समय-अरथ लेल गेलइ"
    },
    {
      "kind": "addition",
      "subject": "केकरो",
      "rationale": "हिब्रू के अनिर्दिष्ट नकार के बाक्य पूरा करे बर सर्बनाम जोड़ल गेलन"
    }
  ],
  "translation": "आउ ऊ होतइ झबरा-गाछ जइसन सुखल जंगल-बाद में, आउ देखतइ नञ जब बढिया बात अवतइ; आउ रहतइ सुकखल जगह में, उजाड़ में, खारही धरती, जतय ⟨केकरो⟩ बसतइ नञ।",
