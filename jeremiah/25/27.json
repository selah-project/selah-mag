    {
      "kind": "invitation",
      "subject": "शेओल-प्याला के हुक्म",
      "rationale": "पीअउ-नशा-उलटी-गिर के लगातार हुक्म — बढ़ावा जे उल्टा अरथ में डुबावऽ हकइ।"
    },
    {
      "kind": "wordplay",
      "subject": "שתו ושכרו וקיו ונפלו",
      "rationale": "चार कड़ी के किरिया-लड़ी, हर एक पछिला के बोझ पर — गिरावट के गति मगही में बनल बाकि ध्वनि-मात्रा बहतइ।"
    },
    {
      "kind": "you",
      "subject": "जाति सब के ओर",
      "rationale": "तोहनी के बीच — जाति सब के सीधे सम्बोधन, यरमयाह के मुँह से।"
    }
  ],
  "translation": "आउ तूँ ओकनी से कहबइ: यहवे त्सबाओत, यिस्राएल के एलोहीम, एहना कहलन — पिअउ आउ नशा करअउ, उलटी करअउ आउ गिर जाअउ, आउ ओ तलवार के मुँह से नञ उठबउ, जेकरा हम तोहनी के बीच भेजतइ।",
