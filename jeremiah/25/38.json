    {
      "kind": "addition",
      "subject": "⟨अपन⟩",
      "rationale": "इब्रानी में पूर्वाधिकार-चिन्हा नञ हइ; ऊ आगे-पाछे के संग जोड़े बर मगही में जोड़ल गेलन।"
    }
