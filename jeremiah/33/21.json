    {
      "kind": "crux",
      "subject": "בריתי תפר",
      "rationale": "'हमरी वाचा तोरल जा होतइ' — वाक्य शर्त के हिस्सा हकइ (पद 20 के 'अगर' के आगे); किछु अनुवाद एके ठोस घोसना बना देलक जे वाचा टूट गेलइ हे"
    }
