    {
      "kind": "idiom",
      "subject": "हम अपन आँख तोहर ऊपर रखबइ",
      "rationale": "אשים את עיני עליך — शाब्दिक 'आँख रखबइ', अरथ ध्यान आउ सँभाल।"
    },
    {
      "kind": "wordplay",
      "subject": "טוב \/ רע",
      "rationale": "अच्छा-बुरा के जोड़ी दू कर आवऽ हइ — बात ले के पूरा छंद संतुलन में हइ।"
    },
    {
      "kind": "you",
      "subject": "यिर्मियाहू",
      "rationale": "नबूजरादान के सीधा बिनती — जाए के खुल्ला अधिकार देल जा रहलइ।"
    }
  ],
  "translation": "आउ अब देखऽ — आज हम तोहका ओ बेड़ी से खोलऽ हिअए जे तोहर हाथ पर हल। जेकरा तोहर आँख में अच्छा लगऽ हइ हमर संग ⟨את⟩ बाबेल जाए के, त जा; आउ हम ⟨את⟩ अपन आँख तोहर ऊपर रखबइ। आउ जेकरा तोहर आँख में बुरा लगऽ हइ हमर संग ⟨את⟩ बाबेल जाए के, त रुक जा। देखऽ — सब धरती तोहर आगू हइ; जइसन अच्छा आउ जइसन सीधा तोहर आँख में जाए के लगऽ हइ, ओइसने ओत्ते जा।",
