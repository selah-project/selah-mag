    {
      "kind": "crux",
      "subject": "גאון הירדן",
      "rationale": "'यर्दन के ओहाट' — नदी के बाढ़\/गर्व के झुण्ड; 'उफान' बनाम 'घना झाड़' के झगड़ा।"
    },
    {
      "kind": "crux",
      "subject": "כאריה",
      "rationale": "सेर यहवे हकइ बा बाबिल के राजा — अनुवादक में फरक हइ।"
    },
    {
      "kind": "you",
      "subject": "यहवे के रिश्ता-परति",
      "rationale": "तीन सवाल ओकरा कोनो सामने के दावे के नकारऽ हइ।"
    }
  ],
  "translation": "देखऽ — जइसन सेर यर्दन के ओहाट से उठ के टिकल ठिकाना के तरफ चढ़तइ; काहे कि हम अचानक ओकरा ओकरा ऊपर से भगा देबइ, आउ जे चुनल गेलै होतइ, हम ओकरा ऊपर नियुक्त करबइ; काहे कि हम जइसन कोनो हकइ? आउ कोनो हकइ जे हमरा सामना तय करतइ? आउ ई गड़ेरिया कोनो हकइ जे हमरा सामने खड़ा हो सकतइ?",
