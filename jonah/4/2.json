    {
      "kind": "idiom",
      "subject": "ארך אפים",
      "rationale": "शाब्दिक 'लम्बा नाक-छेद' — क्रोध में धीर; नाक से साँस फूलावे के तस्वीर।"
    },
    {
      "kind": "substitution",
      "subject": "ונחם על הרעה",
      "rationale": "शाब्दिक 'बुराई पर साँस ले के पछतावल' — बुराई करे से रुक गेल; अनुवाद 'बुराई पर पछतावे वाला'।"
    },
    {
      "kind": "crux",
      "subject": "על כן קדמתי לברח",
      "rationale": "केजेवी 'पहिले भागल' बनाम वाईएलटी 'पहिले से जानत रहनी'; कदम 'पहिले हो के' — मगही में 'पहिले-पहिल जुटलहनी'।"
    },
    {
      "kind": "you",
      "subject": "योना के प्रार्थना",
      "rationale": "योना सीधे यहवे के संबोधन करऽ हइ — 'हे यहवे'।"
    }
  ],
  "translation": "आउ ओ यहवे के आगे प्रार्थना करलक आउ कहलन — हे यहवे, की ई हमर बात नञ रहलइ जबे हम अबहीं अपन धरती में रहनिहार रहनी? एहे से हम तर्शीस के ओर भाग जेबाके पहिले-पहिल जुटलहनी; काहे कि हम जाननिहाल रहनी जे तूँ एक कृपालु एल हौ, दयालु, क्रोध में धीर, हेसेद में बड़, आउ बुराई पर पछतावे वाला।",
