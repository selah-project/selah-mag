    {
      "kind": "crux",
      "subject": "היוצא",
      "rationale": "'जे-करा भी निकलतइ' — मूल पाठ जानवर या मनुस दुनो बर खुललइ; यिफ्तह शायद जानवर के आस रखलन हतन, बाकि कथा ओकरा बेटी के देखावऽ हइ।"
    },
    {
      "kind": "crux",
      "subject": "והעלिपהו עולה",
      "rationale": "'ऊ यहवे के होतइ' आउ 'हम ओकरा चढ़ाबइ' — कुछ पढ़निहार दुनो जोड़ लेथिन (मनुस बलि), कुछ पहिला भाग के पूरा बलि समझथिन; पाठ अस्पस्ट रहऽ हइ।"
    },
    {
      "kind": "wordplay",
      "subject": "העלה\/עולה",
      "rationale": "चढ़ाना (alah) आउ चढ़ाव-बलि (olah) एके जड़ के — 'चढ़ाबइ चढ़ाव-बलि' में एकर गूँज बचलइ।"
    },
    {
      "kind": "mystery",
      "subject": "वादा के लक्ष्य",
      "rationale": "जे निकलतइ ओकर नाम-जात नञ हइ — पाठ जान-बूझ के ओझेल रखऽ हइ।"
    }
  ],
  "translation": "तब जे-करा भी हमरा घर के दुआरी से हमरा भेंट के बर निकलतइ, जब हम अम्मोन के बेटा सब से सांति से लउटतइ — ऊ यहवे के ⟨होतइ⟩, आउ हम ओकरा चढ़ाव-बलि कइके चढ़ाबइ।",
