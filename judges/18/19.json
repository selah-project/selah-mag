    {
      "kind": "idiom",
      "subject": "हाथ मुँह पर राखल",
      "rationale": "इब्रानी चाल के चुप रहे के इसारा — जस के तस राखल गेलइ, काहे कि मूरति के अरथ में नञ।"
    },
    {
      "kind": "you",
      "subject": "दान के लोग पुरोहित से",
      "rationale": "पाँच आदमी आउ छः सय के तरफ से पुरोहित के सीधे बुलावा आउ प्रस्न।"
    },
    {
      "kind": "invitation",
      "subject": "हमनी संग चल",
      "rationale": "पुरोहित के बोलावा — आउ आकर्षण (एक घर बनाम पूरा गोत) के प्रस्न।"
    }
  ],
  "translation": "आउ ओकनी ओकरा कहलन — चुप रह, तोहर हाथ के तोहर मुँह पर राख, आउ हमनी संग चल, आउ हमनी बर बाप आउ पुरोहित बन; की ठीक हइ — एक्को आदमी के घर बर पुरोहित बनल, अथवा यिस्राएल में एक गोत आउ कुनबा बर पुरोहित बनल?",
