    {
      "kind": "crux",
      "subject": "हबइत योम धरात",
      "rationale": "पूर्ण काल (तूँ ओ दिन आन देलहुँ — KJV\/ASV) बनाम भबिस बर आग्रह (ओ दिन अनावऽ हा — BSB); मगही में पूर्ण काल रखल गेल।"
    },
    {
      "kind": "wordplay",
      "subject": "שמעו…שמעו",
      "rationale": "एके क्रिया दू बेर — पहिला सुननिहार सामान्य, दोसर दुसमन; मगही में दोहराव रहल।"
    },
    {
      "kind": "you",
      "subject": "यहवे से",
      "rationale": "आखरी अर्ध पंक्ति सीधे यहवे से बात करऽ हइ।"
    }
  ],
  "translation": "ओकनी सुनलन कि हम आह भरऽ हिअइ; हमरा सांति देवेवाला ⟨केकरो⟩ नञ; हमर सब दुसमन हमर बुराय के सुनलन; ओकनी खुश होलन काहे कि तूँ एकरा कइलहुँ; तूँ ओ दिन आन देलहुँ जेकरा तूँ पुकारलहुँ, आउ ओकनी हमरा जइसन हो जातइ।",
