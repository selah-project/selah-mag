    {
      "kind": "idiom",
      "subject": "מבלי באי מועד",
      "rationale": "‘नियत बेदी के आवै वाला के अभाव में’ — मगही में कारण बनाके ‘काहे कि’ से खोलल गेलन।"
    },
    {
      "kind": "hapax-adjacent",
      "subject": "נוגות",
      "rationale": "यागा के इ रूप — निराशा से झुकल चेहरा के साफ चित्र; मगही में ‘धोका-भरा मुँह’ लेके बैठल से देखावल गेलन।"
    },
    {
      "kind": "wordplay",
      "subject": "מר",
      "rationale": "मर (कड़वा) मर्याम के नाँव जइसने ध्वनि देतइ; पूरा अध्याय में विलाप के कड़वाही एही शब्द से गूँजऽ हइ।"
    },
    {
      "kind": "alternative",
      "subject": "कुँवारी दुःखी भ गेलन",
      "rationale": "नूगोत के बर सादा पढ़ाई — ‘व्यथित भ गेलन’; ‘धोका-भरा मुँह’ बेसी साफ चित्र वाला चुनाव हकइ।"
    }
  ],
  "translation": "त्सियोन (सियोन) के रस्ता शोक मनावऽ हइ, काहे कि नियत-परब के बेदी के दिन कोनो नञ आवऽ हइ; ओकर सब केवाड़ी उजाड़ भ गेलन, ओकर पुरोहित सिसकऽ हथिन, ओकर कुँवारी धोका-भरा मुँह लेके बैठल हथिन, आउ ओकरा बर कड़वाही हकइ।",
