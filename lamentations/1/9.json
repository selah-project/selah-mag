    {
      "kind": "crux",
      "subject": "פלאים",
      "rationale": "शाब्दिक 'अचम्भे' — किछु 'अचम्भा के रस्ते' कहऽ हइ, किछु 'बड़ दुख के संग' पढ़ऽ हथिन।"
    },
    {
      "kind": "addition",
      "subject": "एहे से",
      "rationale": "ותרד के आगे कारण-जोड़ सब्द जोड़ल गेलइ, हिब्रू में सुचारू रूप से नञ हइ।"
    },
    {
      "kind": "you",
      "subject": "यहवे",
      "rationale": "परमेश्वर के सीधा सम्बोधन — 'देखऽ, हे यहवे'।"
    },
    {
      "kind": "invitation",
      "subject": "ראה",
      "rationale": "देखऽ होकर आज्ञा यहवे के सोझा दुख दिखावे बर बेनती हकइ।"
    }
  ],
  "translation": "ओकर घाछनी में गन्दगी हकइ; ऊ आपन आखिरी दसा नञ सोचलक; एहे से ऊ अचम्भा के रस्ते नीचे गेलइ; ओकरा कोनो सांति देवइ वाला नञ हलइ। देखऽ, हे यहवे, ⟨את⟩ हमर दुख-तकलीफ, काहे कि बैरी बड़ हो गेलइ हे।",
