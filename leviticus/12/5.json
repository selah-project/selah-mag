    {
      "kind": "idiom",
      "subject": "כנדתה",
      "rationale": "अशुचि-काल के समान — ओकर रजस्वला-अशुचि जैसन; इब्रानी नैदा नामक अवस्था के बात करऽ हइ।"
    }
