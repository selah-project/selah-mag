    {
      "kind": "crux",
      "subject": "יקדש",
      "rationale": "'ऊ पवित्तर हो जातइ' बनाम 'ऊ पवित्तर करा जातइ' — छुअने से पवित्तरता मिलेला कि सख्त करा जातइ, अनुवादकनी के पुरान झगड़ा।"
    }
