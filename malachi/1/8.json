  "notes": [
    {
      "kind": "addition",
      "subject": "⟨पसु⟩",
      "rationale": "इब्रानी खाली गुण-सब्द देतइ — अन्हरा, लङगड़ा, बीमार — जानवर के अनुमान चाही।"
    },
    {
      "kind": "idiom",
      "subject": "मुँह उठाना",
      "rationale": "ׄנשא פנים — मुँह उठावऽ — अनुग्रह देखावे के इब्रानी मुहावरा हकइ; शाब्दिक रूप रखल गेलइ।"
    },
    {
      "kind": "alternative",
      "subject": "אין װע",
      "rationale": "कुछ अनुवादी एकरा प्रस्न बनावऽ हइ (की ई बुरा नञ हइ?); इब्रानी पाठ बयान हकइ — कटाक्ष।"
    },
    {
      "kind": "invitation",
      "subject": "एकरा अब परोस",
      "rationale": "आज्ञा-रूप सरदार के दने परीक्षा बर बोलावऽ हइ।"
    }
  ],
  "translation": "आउ जब तोहनी अन्हरा ⟨पसु⟩ बलि बर परोसऽ हइ — बुरा नञ हइ! आउ जब तोहनी लङगड़ा आउ बीमार ⟨पसु⟩ परोसऽ हइ — बुरा नञ हइ! एकरा अब अपन सरदार के परोस — की ऊ तोहके भावैतइ, की ऊ तोहर मुँह उठातइ? यहवे त्सबाओत के बचन।",
