    {
      "kind": "elision",
      "subject": "אתה (पहिला)",
      "rationale": "डोरावल गेल धरती के चिन्हा — अनुवाद-पाँती में ⟨אत⟩ के रूप में चिन्हांकित, कोनो सब्द नञ।"
    },
    {
      "kind": "crux",
      "subject": "אכלת יושביה",
      "rationale": "'बसनिहार के खाय' — किछु पढ़निहार अरथ देहथिन: भीतर के झगड़ा से जनसंख्या घटऽ हइ, या ओकरा बलवान लोग ओकरा खा जाय।"
    }
