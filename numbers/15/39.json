    {
      "kind": "crux",
      "subject": "तोहनी देखथिन",
      "rationale": "אתו के बचन-बचन अरथ — एकवचन 'ओकरा' या फुँदना सब के — मानक अनुवाद में मतभेद हकइ; एकवचन रूप एके रखलन।"
    },
    {
      "kind": "substitution",
      "subject": "व्यभिचार करऽ हिया",
      "rationale": "זנים शाब्दिक रूप से वेश्यागमन हकइ; एकर प्रयोग अन्य देवता के पाछे जाए के रूपक के रूप में भी अनुवादित होत हकइ।"
    },
    {
      "kind": "idiom",
      "subject": "घूमथिन",
      "rationale": "תתרו के मूल अरथ टहलना\/जासूसी करना हकइ — 'खोज करना' बनाम 'भटकना' दुनू अनुवाद चलन में हकइ।"
    },
    {
      "kind": "you",
      "subject": "तोहनी",
      "rationale": "पूरा पद यिस्राएल के लोग के सीधा सम्बोधन हकइ।"
    }
  ],
  "translation": "आउ ऊ तोहनी बर फुँदना बनिहइ, ताकि तोहनी ⟨आहाँ⟩ ⟨את⟩ ओकरा देखथिन आउ यहवे के सब आज्ञा ⟨את⟩ सब के स्मरण करथिन आउ ⟨את⟩ ओकरा करथिन, आउ तोहनी अपना हिरदय के पाछे आउ अपना आँखि के पाछे नञ घूमथिन, जेकर पाछे तोहनी व्यभिचार करऽ हिया।",
