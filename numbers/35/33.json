    {
      "kind": "crux",
      "subject": "חנף",
      "rationale": "'मैला करना' बनाम 'पवित्तरता भंग करना \/ बेईमानी करना' — חנף नैतिक मैल के जड़ हकइ, परम्परा में pollute आउ profane दूनो चलन हइ।"
    },
    {
      "kind": "crux",
      "subject": "יכפר",
      "rationale": "כפר के जड़ 'ढकना' हकइ; 'छुटकारा', 'प्रायस्चित' आउ 'माफी' — तीनो परम्परा में बाँटल हइ।"
    },
    {
      "kind": "idiom",
      "subject": "כי אם",
      "rationale": "इब्रानी 'काहे कि अगर' = 'खाली…से' (except by); मगही में एक्को सब्द 'खाली' से देखाओल गेलइ।"
    },
    {
      "kind": "wordplay",
      "subject": "תחניפו \/ יחניף",
      "rationale": "एके जड़ के दोहराव — जे धरती के मैला करऽ हथिन, ओतय खूनू ओकरा मैला करऽ हइ; आगे שפך तीन बेर।"
    },
    {
      "kind": "you",
      "subject": "यिस्राएल के लोग",
      "rationale": "पद तोहनी (बहुबचन) के सीधे आदेस हकइ।"
    }
  ],
  "translation": "आउ ओ धरती के मैला मत करऽ जेमा तोहनी रहऽ हथिन, काहे कि खून ऊ ⟨את⟩ धरती के मैला करऽ हइ, आउ ओ धरती बर ओ खून के छुटकारा नञ होतइ जे ओकरा में ढारल गेलइ — खाली ढारे वाला के खून से।",
