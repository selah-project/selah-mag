    {
      "kind": "crux",
      "subject": "שתיתם על הר קדשי",
      "rationale": "'पीना' साक्तार्थ हकइ (यरूशलयिम के सताए के कट), या साक्षात पियावल; दुनो पढ़ाई चलऽ हइ।"
    },
    {
      "kind": "wordplay",
      "subject": "שתו \/ לעו",
      "rationale": "पीए आउ गटके के पाँती — कट के प्याला के चित्र, तीन बेर शाता जड़ के दोहराव।"
    },
    {
      "kind": "you",
      "subject": "एदोम",
      "rationale": "'तोहनी पीलन' — एदोम के सीधा सम्बोधन जारी हकइ।"
    }
  ],
  "translation": "काहे कि जइसन तोहनी हमर पवित्तर पहाड़ पर पीलन, ओइसने सब जाति लगातार पीबइ; आउ पीबइ आउ गटकबइ, आउ होतइ जइसन कि ओकनी कहियो नञ रहलन।",
