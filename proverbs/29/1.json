    {
      "kind": "addition",
      "subject": "तबो",
      "rationale": "हिब्रू में 'मक्षे ढरफ' के संग कोनो विरोधी जोड़-सब्द नञ हइ; अरथ स्पस्ट करे बर जोड़ल गेलन।"
    },
    {
      "kind": "idiom",
      "subject": "गरदन कठोर करना",
      "rationale": "हिब्रू 'ערף मक्षה' — गरदन के पिछला भाग कठोर करना — अवज्ञा के मुहावरा हकइ।"
    },
    {
      "kind": "wordplay",
      "subject": "ישבר \/ מרפא",
      "rationale": "टूटल आउ इलाज के जोड़ी — टूटल चीज के जोड़ल नञ जा सकऽ हइ, ई विरोधाभास हिब्रू के तनाव हकइ।"
    }
  ],
  "translation": "जे आदमी बार-बार फटकार सुनके ⟨तबो⟩ गरदन कठोर रखऽ हइ, ओ अचानक टूट जतइ आउ ओकर कोनो इलाज नञ होतइ।",
