    {
      "kind": "wordplay",
      "subject": "מי ... מי ... मी",
      "rationale": "चारि दने 'कोन' के दोहराव — गिनती वाला ढाँचा, ओहे ताल धरल गेलइ।"
    },
    {
      "kind": "crux",
      "subject": "כי תדע",
      "rationale": "'की तूँ जानऽ हँ?' (परसोन, jps) बनाम 'तैं जानऽ हँ!' (jot, ylt — जवाब जइसन)।"
    },
    {
      "kind": "crux",
      "subject": "ओकर बेटा के नाम",
      "rationale": "बेटा के कोन हइ — पहिला पढ़निहार बर ई खुलल परसोन हकइ; पाछे के अरथ ओकरा मत जोड़ल गेलइ।"
    },
    {
      "kind": "mystery",
      "subject": "पूरा पद",
      "rationale": "छह परसोन बिना जवाब के — नाम गिरप्तार रहऽ हइ।"
    },
    {
      "kind": "invitation",
      "subject": "पद के अंतिम परसोन",
      "rationale": "पढ़निहार के दने सीधे परसोन — 'की तूँ जानऽ हँ?'"
    }
  ],
  "translation": "कोन अकास पर चढ़लन आउ उतरलन? कोन ओकर दूनो मुट्ठी में रूआख के भरलन? कोन कपड़ा में पानी के बाँधलन? कोन धरती के सब किनारा के ठाढ़ कइलन? ओकर नाम की हइ, आउ ओकर बेटा के नाम की हइ — की तूँ जानऽ हँ?",
