    {
      "kind": "crux",
      "subject": "עד ככר לחם",
      "rationale": "परम्परा में दू अरथ: बेसवा के दाम रोटी के टुकड़ा जेतना (सस्ता), या बेसवा आदमी के रोटी के टुकड़ा जेतना (कंगाल) कर देऽ हइ।"
    },
    {
      "kind": "addition",
      "subject": "आदमी",
      "rationale": "हिब्रू में करता बिना के बाक्य हकइ; पीड़ित करता मगही में जोड़ल गेलन।"
    },
    {
      "kind": "substitution",
      "subject": "शिकार",
      "rationale": "תצוד शिकार करे के क्रिया हकइ — जानवर के घात लगावे जइसन — परान के बर रूपक।"
    },
    {
      "kind": "substitution",
      "subject": "परान",
      "rationale": "נפש के अरथ जीवन-शक्ति हकइ, दार्शनिक आत्मा नञ।"
    }
  ],
  "translation": "काहे कि बेसवा जनाना के बर ⟨आदमी⟩ रोटी के एक टुकड़ा ⟨तक⟩ गेलइ, आउ दोसर के जनाना बहुमूल्य परान के शिकार करऽ हइ।",
