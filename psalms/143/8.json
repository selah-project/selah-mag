    {
      "kind": "idiom",
      "subject": "परान उठाइलिए",
      "rationale": "नासा नाफेस — इब्रानी मुहावरा, तोहर दने पूरा मन लगा के ताकना; मगही में इएन 'परान उठाना' बोलल जा हइ"
    }
