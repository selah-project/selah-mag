    {
      "kind": "crux",
      "subject": "כבוד",
      "rationale": "'महिमा' (KJV 'my glory') बनाम 'जीभ' (Geneva, LXX) — मूल पाठ 'काबोद' हकइ, महिमा।"
    },
    {
      "kind": "substitution",
      "subject": "धन्यवाद",
      "rationale": "אודך (यादा) के मूल अरथ 'फेंकना\/संग देना' हकइ; मगही में धन्यवाद कइल गेलइ।"
    },
    {
      "kind": "addition",
      "subject": "हे",
      "rationale": "इब्रानी में बोलावे के चिन्हा नञ हइ; सम्बोधन बर हे जोड़ल गेलइ।"
    },
    {
      "kind": "wordplay",
      "subject": "יזמרך\/ידם",
      "rationale": "बाजा बजावे बनाम चुप रहे — गइल गीत आउ रुकल चुप्पी के टकराव, मगही में गुनगान\/चुप में आंशिक रहऽ हइ।"
    }
  ],
  "translation": "एकरा चलते हमर महिमा तोहर गुनगान गावऽ हइ आउ चुप नञ रहऽ हइ; हे यहवे, हमर एलोहीम, हम सदा बर तोहर धन्यवाद करबइ।",
