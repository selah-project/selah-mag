    {
      "kind": "crux",
      "subject": "את מזבחותיך",
      "rationale": "'तोहर बेदी सब के पास' — चिरई के घोंसला बेदी के पास हकइ या बेदी पर; 'के पास' जोड़ल।"
    },
    {
      "kind": "hapax",
      "subject": "דרור",
      "rationale": "'अबाबील' (swift\/swallow) के जाति-नाम — तनाख़ में एहे अरथ में कम आवऽ हइ।"
    },
    {
      "kind": "addition",
      "subject": "के पास",
      "rationale": "इब्रानी केवल 'तोहर बेदी सब' कहऽ हइ — स्थान-सम्बन्ध जोड़ल गेल।"
    },
    {
      "kind": "you",
      "subject": "यहवे त्सबाओत",
      "rationale": "'हमर राजा आउ हमर एलोहीम' — प्रत्यक्ष सम्बोधन।"
    }
  ],
  "translation": "चिरई घर ढूँढ़ लेलक, आउ अबाबील के अपन घोंसला, जहाँ ऊ ⟨את⟩ अपन बच्चा सब रखलक, तोहर बेदी सब के पास, हे यहवे त्सबाओत, हमर राजा आउ हमर एलोहीम।",
